{
  "compilerOptions": {
    "jsx": "react-jsx", // for React 17+ with the new JSX transform
    "module": "esnext",
    "target": "es5",
    "lib": ["dom", "esnext"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
